{
  "name": "tippy-alerts-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply tippy_alerts --remote",
    "db:migrate:local": "wrangler d1 migrations apply tippy_alerts --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
