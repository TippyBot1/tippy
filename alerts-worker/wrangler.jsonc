{
  // Tippy alerts: Telegram bot webhook + /notify + dead-man heartbeats.
  "name": "tippy-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tippy_alerts",
      "database_id": "cf74685b-aa7a-4d84-85b0-f2e611f79111",
      "migrations_dir": "migrations"
    }
  ],
  // Dead-man check every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "BOT_USERNAME": "TippyBotAlerts" },
  "routes": [{ "pattern": "alerts.tippybot.fun", "custom_domain": true }]
  // Secrets (never in this file) — set both, and the Telegram webhook, with:
  //   ./connect-telegram.sh   (asks for the @BotFather token without showing it)
}
